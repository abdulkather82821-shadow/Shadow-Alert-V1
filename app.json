{
  "expo": {
    "name": "Shadow Alert",
    "slug": "shadow-alert",
    "version": "1.0.0",
    "description": "A gentle screen-time coach for intentional app limits and restorative pauses.",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/images/shadow-alert-icon.png",
    "scheme": "shadow-alert",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/shadow-alert-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.shadowalert.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
